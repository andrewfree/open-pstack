#!/usr/bin/env bash
# Uses only Bash built-ins, because Git Bash on Windows can start the hook
# without /usr/bin on PATH. Splits $0 on its last / or \ (run-hook.cmd's cmd
# half passes a Windows path) instead of calling dirname, and reads with
# $(<file) instead of cat; the assignment fails under set -e when the file is
# missing.

set -euo pipefail

case "$0" in
  */*|*\\*) dir="${0%[/\\]*}" ;;
  *) dir=. ;;
esac
context="$(<"$dir/session-start-context.md")"
printf '%s\n' "$context"
